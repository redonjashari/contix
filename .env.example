# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://concert_user:concert_pass@localhost:5432/concert_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-here
JWT_REFRESH_SECRET=your-refresh-secret-minimum-32-characters-long-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Redis (Optional)
REDIS_URL=redis://localhost:6379

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Hold Configuration
HOLD_TTL_SECONDS=600
HOLD_CLEANUP_INTERVAL=60000

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=12
