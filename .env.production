# Production Environment Variables
NODE_ENV=production
PORT=3001

# Database
DATABASE_URL=postgresql://concert_user:concert_pass@postgres:5432/concert_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-here
JWT_REFRESH_SECRET=your-refresh-secret-minimum-32-characters-long-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your_stripe_live_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Redis
REDIS_URL=redis://redis:6379

# Frontend URL
FRONTEND_URL=https://your-domain.com

# Hold Configuration
HOLD_TTL_SECONDS=600
HOLD_CLEANUP_INTERVAL=60000

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=12
