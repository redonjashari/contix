{
  "name": "contix",
  "version": "1.0.0",
  "type": "module",
  "description": "A modern concert ticket platform built with Node.js, TypeScript, React, and PostgreSQL",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/workers/holdCleaner.worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "docker:build": "docker build -f docker/Dockerfile -t contix .",
    "docker:run": "docker run -p 3001:3001 contix",
    "deploy:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "deploy:down": "docker-compose -f docker-compose.prod.yml down",
    "logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "health": "curl -f http://localhost:3001/health || exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redonjashari/contix.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/redonjashari/contix/issues"
  },
  "homepage": "https://github.com/redonjashari/contix#readme",
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.7.2",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.17.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "bcrypt": "^5.1.1",
    "fastify": "^5.6.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.0.0",
    "pino-pretty": "^10.3.1",
    "qrcode": "^1.5.4",
    "stripe": "^19.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
